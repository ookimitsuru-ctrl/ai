{
  "name": "hitorigoto-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ひとりごと(AIフォロワーSNS)のサーバー。Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "try-llm": "tsx scripts/try-llm.ts",
    "try-lookup": "tsx scripts/try-lookup.ts",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply hitorigoto --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "latest",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
