{
  "name": "aether-lance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --outDir dist-single-tmp --emptyOutDir && node scripts/singlefile.mjs dist-single-tmp dist-single/aether-lance.html",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
